{
  "name": "@onchainid/issuer-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offchain ONCHAINID claim-issuer API — signs KYC claims matching ClaimIssuer.sol",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "viem": "2.21.0"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "tsx": "4.19.2",
    "typescript": "5.5.4"
  }
}
