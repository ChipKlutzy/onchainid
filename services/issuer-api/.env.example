# issuer-api configuration. Copy to .env (gitignored) and fill in.
# NEVER commit a real key. Use a throwaway Anvil/local key only.

PORT=8787
KYC_TOPIC=1

# 32-byte hex private key for the claim signer EOA.
ISSUER_PRIVATE_KEY=0xYOUR_THROWAWAY_ANVIL_KEY

# Optional. When set, enables POST /v1/claims/issue (broadcasts Identity.addClaim).
ISSUER_RPC_URL=http://127.0.0.1:8545

# CORS origin allowed to call this API. Use the dapp origin, or "*" for local demo.
ALLOWED_ORIGIN=http://localhost:3000
